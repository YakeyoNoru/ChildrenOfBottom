# .env로 복사한 뒤 node --env-file=.env server.js로 실행한다.
# 비밀키는 서버에만 보관하며 Android BuildConfig나 브라우저 코드에 넣지 않는다.
# HTTP·WebSocket 서버가 사용할 수신 포트
PORT=3000
# 실제 계정 서버의 HTTPS 출처. 경로와 끝 슬래시는 제외
PUBLIC_BASE_URL=https://game.example.com
# WebSocket 연결을 허용할 브라우저 출처
ALLOWED_ORIGIN=https://game.example.com
# 계정과 설정을 보관할 서버 파일 경로
ACCOUNTS_FILE=.data/accounts.json
# 구글 개발자 설정에서 받은 서버용 클라이언트 ID
GOOGLE_CLIENT_ID=
# 구글의 서버 전용 인증 비밀키
GOOGLE_CLIENT_SECRET=
# 카카오 개발자 앱의 REST API 키
KAKAO_REST_API_KEY=
# 카카오의 서버 전용 인증 비밀키
KAKAO_CLIENT_SECRET=
