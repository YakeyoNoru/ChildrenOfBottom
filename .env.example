# Copy to .env; run: node --env-file=.env server.js
# Keep secrets on the server. Never put them in Android BuildConfig or browser JS.
PORT=3000
PUBLIC_BASE_URL=https://game.example.com
ALLOWED_ORIGIN=https://game.example.com
ACCOUNTS_FILE=.data/accounts.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
